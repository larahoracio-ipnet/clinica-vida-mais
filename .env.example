# ==============================================================================
# CONFIGURAÇÕES DE IA GENERATIVA (GOOGLE AI STUDIO - FREE TIER)
# ==============================================================================
GEMINI_API_KEY="cole_sua_chave_gratuita_do_google_ai_studio_aqui"
GEMINI_MODEL_NAME="gemini-3.1-flash-lite"
# Modelos reserva, na ordem em que serão tentados se o principal falhar (separados por vírgula)
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-flash-lite-latest"
# Tentativas no mesmo modelo em erro transitório (429/5xx/timeout), com espera exponencial
GEMINI_TENTATIVAS_POR_MODELO=2
GEMINI_TIMEOUT_SECONDS=60

# ==============================================================================
# CAMINHOS DAS BASES DE REFERÊNCIA E DADOS (RELATIVOS À RAIZ clinica-vida-mais/)
# ==============================================================================
TUSS_CSV_PATH="ia_ocr_rag/data/reference/tuss-22_20260902.xlsx - tuss-22_20260902.csv"
PACIENTES_CSV_PATH="ia_ocr_rag/data/reference/pacientes_simulados.csv"
INPUT_GUIAS_DIR="ia_ocr_rag/data/input_guias"
GABARITO_CSV_PATH="ia_ocr_rag/data/gabarito/gabarito.csv"
OUTPUT_JSON_DIR="ia_ocr_rag/data/output_json"

# ==============================================================================
# CONTROLE DE QUALIDADE (CLINICA VIDA+)
# ==============================================================================
HITL_CONFIDENCE_THRESHOLD=90.0
BATCH_SLEEP_SECONDS=4.5